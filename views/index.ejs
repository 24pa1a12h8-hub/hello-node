<!DOCTYPE html>
<html>
<head>
    <title>To-Do Manager</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-white">

    <div class="grid grid-cols-6">

        <div class="col-start-3 col-span-2">

            <h1 class="text-2xl font-semibold text-gray-600 mt-8">
                My Todo-list
            </h1>

            <form>
                <div class="flex gap-2 py-4">

                    <div class="flex-auto w-64">
                        <input
                            type="text"
                            class="border border-gray-300 text-gray-900 text-sm rounded w-full p-2"
                            placeholder="What's next?"
                            autofocus
                            required
                        >
                    </div>

                    <div class="flex-auto w-32">
                        <input
                            type="date"
                            class="border border-gray-300 text-gray-900 text-sm rounded w-full p-2"
                        >
                    </div>

                    <div class="flex-none">
                        <button
                            type="submit"
                            class="text-white bg-green-600 hover:bg-green-700 font-medium rounded text-sm px-5 py-2"
                        >
                            Add
                        </button>
                    </div>

                </div>
            </form>

            <div class="mt-2">

                <h2 class="text-lg text-gray-700 mt-4">
                    Overdue (<%= overdue.length %>)
                </h2>

                <%- include("todos", { todos: overdue, today: today }) %>


                <h2 class="text-lg text-gray-700 mt-4">
                    Due Today (<%= dueToday.length %>)
                </h2>

                <%- include("todos", { todos: dueToday, today: today }) %>


                <h2 class="text-lg text-gray-700 mt-4">
                    Due Later (<%= dueLater.length %>)
                </h2>

                <%- include("todos", { todos: dueLater, today: today }) %>

            </div>

        </div>

    </div>

</body>
</html>